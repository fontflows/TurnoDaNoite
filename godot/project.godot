; Arquivo de configuração do projeto Godot.
; Pode ser editado pelo menu Projeto > Configurações do Projeto.

config_version=5

[application]

config/name="Turno da Noite"
config/description="Pizzaria do Tito: sobreviva ao turno da noite religando os disjuntores."
run/main_scene="res://ui/aviso_fones.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icone/icone.png"
config/windows_native_icon="res://assets/icone/icone.ico"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Jogo="*res://scripts/jogo.gd"
Config="*res://scripts/config.gd"
FiltroVHS="*res://ui/filtro_vhs.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/tema.tres"

